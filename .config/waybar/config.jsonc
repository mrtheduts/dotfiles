{
  "layer": "top",
  "position": "top",

  "spacing": 0,
  "width": 0,
  "height": 0,

  "bar_id": "bar-0",
  "ipc": true,

  "modules-left": [
    "cpu",
    "temperature",
    "memory",
    "disk#1",
    "disk#2",
    "sway/scratchpad",
    "sway/mode",
  ],
  "modules-center": ["sway/workspaces"],
  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "battery",
    "clock#1",
    "clock#2",
  ],

  "cpu": {
    "interval": 5,
    "format": " {usage}%",
  },

  "temperature": {
    "format": "󰔏 {temperatureC}°C",
  },

  "disk#1": {
    "path": "/",
    "format": "󰿠 <b>{percentage_used}%</b>",
  },

  "disk#2": {
    "path": "/home",
    "format": " <b>{percentage_used}%</b>",
  },

  "clock#1": {
    "format": "  {:%H:%M}",
    "tooltip": false,
  },

  "clock#2": {
    "format": " {:%e %B %Y}",
    "tooltip": false,
  },

  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": ["", "󰨝"],
    "tooltip": true,
    "tooltip-format": "{app}: {title}",
  },

  "sway/mode": {
    "format": " Mode: <b>{}</b>",
  },

  "sway/workspaces": {
    "on-click": "activate",
    "format": "<b>{name}</b> : {windows}",
    "format-window-separator": " / ",
    "window-format": "{name}",
    "window-rewrite-default": "{name}",
    "window-rewrite": {
      "class<.*qutebrowser>": "",
      "class<.*wezterm>": "",
      "class<.*telegram.*desktop>": "",
      "class<Godot>": "",
      "class<.*Zed>": "Zed",
      "class<.*pavucontrol>": "",
      "class<io.ente.auth>": "󰌾",
      "class<ente>": "",
      "class<vlc>": "󰕼",
      "class<keymapp>": "",
    },
  },

  "tray": {
    "spacing": 10,
    "icon-size": 20,
  },

  "memory": {
    "interval": 5,
    "format": "  <b>{used:0.1f}</b>/<b>{total:0.1f}</b> GiB",
    "tooltip": false,
  },

  "network": {
    "format-wifi": "{icon} {essid}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰀂",
    "format-alt": "󱛇",
    "format-disconnected": "󰖪",
    "interval": 5,
    "tooltip": false,
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-bluetooth": "󰂰",
    "format-icons": {
      "headphone": "",
      "default": ["󰖀", "󰕾", ""],
    },
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    },
    "format-full": "Charged ",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10,
    },
    "tooltip": false,
  },
}
